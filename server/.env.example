PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/tourism_guardian
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Optional. Enriches place search/nearby results when set; every
# feature that can use it already falls back to OpenStreetMap/Overpass
# when it's left blank, so the server still starts and works without it.
GOOGLE_MAPS_API_KEY=

# Optional but recommended: powers reliable tourist-attraction search
# (replaces the flaky public Overpass mirrors). Get a free key at
# https://opentripmap.io/product
OPENTRIPMAP_API_KEY=

WEATHER_API_KEY=your_openweather_key

# One frontend origin, or a comma-separated list (production Vercel URL +
# any preview URLs + local dev). A single entry may use a "*" wildcard,
# e.g. https://*.vercel.app to allow every Vercel preview deployment.
# Example: CLIENT_URL=https://tourism-guardian.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173
SOCKET_URL=http://localhost:5000

AUTHORITY_INVITE_CODE=change_this_secure_invite_code
TRUSTED_CONTACT_WEBHOOK_URL=
